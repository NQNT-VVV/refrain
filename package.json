{
  "name": "refrain",
  "version": "1.0.0",
  "private": true,
  "description": "Refrain — blind test multijoueur : regie animateur, ecran streamable, buzzer mobile.",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "NODE_ENV=production node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/e2e.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "load": "node test/load.mjs",
    "test:rounds": "node test/rounds.mjs",
    "test:norepeat": "node test/norepeat.mjs",
    "test:artist": "node test/artist.mjs",
    "test:pause": "node test/pause.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "next": "^15.5.24",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3"
  }
}
